// Module Version Drift Check
//
// Scans every live/ terragrunt stack and compares its pinned module ref
// against the latest git tag in the upstream repo.
//
// Result:
//   SUCCESS  – all stacks are on the latest tag
//   UNSTABLE – one or more stacks are behind; build description lists them
//
// Scheduled: daily at 08:00 UTC (configurable below).
// Can also be triggered manually or called from another pipeline.

pipeline {
  agent { label 'tofu' }

  options {
    timeout(time: 10, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '60'))
    ansiColor('xterm')
  }

  parameters {
    string(
      name:         'MODULE_REPO_URL',
      defaultValue: 'https://github.com/beravelli/autotfrefresh.git',
      description:  'Module monorepo to check tags against'
    )
    string(
      name:         'ENV_FILTER',
      defaultValue: '',
      description:  'Restrict to a specific env dir (e.g. dev or prod). Empty = all.'
    )
  }

  triggers {
    // Run every day at 08:00 UTC — adjust to taste
    cron('0 8 * * *')
  }

  stages {
    stage('Check module versions') {
      steps {
        script {
          def filter = params.ENV_FILTER?.trim() ?: ''

          // Script exits with the number of stale stacks (0 = clean)
          def staleCount = sh(
            script: """
              bash scripts/check_module_versions.sh \
                '${params.MODULE_REPO_URL}' \
                '${filter}'
            """,
            returnStatus: true
          )

          if (staleCount > 0) {
            currentBuild.result      = 'UNSTABLE'
            currentBuild.description = "⚠ ${staleCount} stack(s) behind latest module tags — see log"
            unstable("${staleCount} stack(s) are behind the latest module tags.")
          } else {
            currentBuild.description = "✓ All stacks up to date"
          }
        }
      }
    }
  }

  post {
    unstable {
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo " ACTION REQUIRED: one or more stacks are out of date."
      echo " To apply the latest version, trigger the refresh pipeline:"
      echo "   http://localhost:8080/job/gitops/job/refresh-pipeline"
      echo " with DRY_RUN=true to preview, then DRY_RUN=false to apply."
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    }
    success {
      echo "✓ All live stacks are pinned to the latest module tags."
    }
  }
}
