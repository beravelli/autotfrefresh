// Live-Infra Direct Action Pipeline
//
// Use this pipeline to validate, plan, or apply terragrunt stacks directly —
// without needing a module version bump to trigger it.
//
// Flexible targeting:
//   • All stacks             — leave all filters empty
//   • By environment         — set ENV_FILTER=dev
//   • By region              — set REGION_FILTER=us-east-1
//   • By module              — set MODULE_FILTER=vpc
//   • Exact stack            — set STACK_FILTER=dev/us-east-1/vpc  (overrides other filters)
//   • Combine any of the above
//
// Flow:
//   1. Validate inputs — summarise targeting + action
//   2. Check module versions (optional) — warn if stacks are behind latest tags
//   3. Discover stacks — find all terragrunt stacks matching the filters
//   4a. Validate   (ACTION=validate) — tofu init -backend=false && tofu validate
//   4b. Plan       (ACTION=plan)     — terragrunt plan with real AWS credentials
//   4c. Plan       (ACTION=apply)    — same as above, output saved for apply step
//   5. Approval gate (ACTION=apply only, unless AUTO_APPROVE=true)
//   6. Apply        (ACTION=apply)   — terragrunt apply from saved plan

pipeline {
  agent { label 'tofu' }

  options {
    timeout(time: 90, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    ansiColor('xterm')
  }

  parameters {
    choice(
      name: 'ACTION',
      choices: ['validate', 'plan', 'apply'],
      description: 'validate = tofu validate only (no AWS). plan = terragrunt plan. apply = plan then apply.'
    )
    string(
      name: 'ENV_FILTER',
      defaultValue: '',
      description: 'Limit to an environment, e.g. dev | prod. Empty = all.'
    )
    string(
      name: 'REGION_FILTER',
      defaultValue: '',
      description: 'Limit to a region, e.g. us-east-1. Empty = all.'
    )
    string(
      name: 'MODULE_FILTER',
      defaultValue: '',
      description: 'Limit to a module, e.g. vpc | eks | rds. Empty = all.'
    )
    string(
      name: 'STACK_FILTER',
      defaultValue: '',
      description: 'Target one exact stack, e.g. dev/us-east-1/vpc. Overrides all other filters.'
    )
    booleanParam(
      name: 'CHECK_MODULE_VERSIONS',
      defaultValue: true,
      description: 'Warn if any targeted stacks are behind their latest module tag before acting.'
    )
    booleanParam(
      name: 'AUTO_APPROVE',
      defaultValue: false,
      description: 'Skip the manual approval gate (apply only). Use only in non-prod CI.'
    )
    booleanParam(
      name: 'UPDATE_MODULES',
      defaultValue: false,
      description: 'If stale stacks are found, prompt to bump their module refs and commit back to the repo.'
    )
    string(
      name: 'GIT_CREDENTIALS_ID',
      defaultValue: '65bff261-a30b-4bc5-90c0-65c23b4ce2ab',
      description: 'Jenkins credentials ID (username+password/token) used to push module ref updates back to GitHub.'
    )
  }

  environment {
    PLAN_DIR = "${WORKSPACE}/plans"
  }

  stages {

    // ── 1. Validate inputs ─────────────────────────────────────────────────
    stage('Validate inputs') {
      steps {
        script {
          def target = params.STACK_FILTER?.trim()
            ?: [params.ENV_FILTER, params.REGION_FILTER, params.MODULE_FILTER]
                 .findAll { it?.trim() }
                 .join('/') ?: 'ALL stacks'

          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo " Action : ${params.ACTION.toUpperCase()}"
          echo " Target : ${target}"
          echo " Drift? : ${params.CHECK_MODULE_VERSIONS}"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        }
      }
    }

    // ── 2. Check module version drift ─────────────────────────────────────
    stage('Check module versions') {
      when { expression { params.CHECK_MODULE_VERSIONS } }
      steps {
        script {
          sh "mkdir -p '${env.PLAN_DIR}'"
          env.UPDATES_FILE = "${env.PLAN_DIR}/stale_stacks.tsv"

          def envArg = params.ENV_FILTER?.trim() ?: ''
          def rc = sh(
            script: """
              bash scripts/check_module_versions.sh \
                '${envArg}' \
                '${env.UPDATES_FILE}'
            """,
            returnStatus: true
          )
          if (rc > 0) {
            env.DRIFT_WARN = "⚠ ${rc} stack(s) are behind their latest module tag — review before applying"
            env.HAS_STALE  = 'true'   // simple flag — avoids toInteger() sandbox issue
            // Build a human-readable list for the approval message
            env.STALE_LIST = sh(
              script: """
                awk -F'|' '{printf "  %-40s %s/%s → %s/%s\\n", \$1, \$2, \$3, \$2, \$4}' \
                  '${env.UPDATES_FILE}'
              """,
              returnStdout: true
            ).trim()
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo " ${env.DRIFT_WARN}"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            currentBuild.description = env.DRIFT_WARN
            // Non-fatal — operator may intend to apply without bumping module versions
          } else {
            echo "✓ All stacks are on the latest module tags."
            env.DRIFT_WARN = ''
            env.HAS_STALE  = 'false'
            env.STALE_LIST = ''
          }
        }
      }
    }

    // ── 2b. Approve module ref updates ────────────────────────────────────
    stage('Approve module updates') {
      when {
        allOf {
          expression { params.UPDATE_MODULES == true }
          expression { env.HAS_STALE == 'true' }
        }
      }
      steps {
        script {
          timeout(time: 1, unit: 'HOURS') {
            env.UPDATE_APPROVED_BY = input(
              message: """\
Bump stale module refs to their latest versions?

${env.STALE_LIST}

This will edit the source refs in live/ and push a commit back to the repo.
Subsequent stages will validate/plan/apply using the updated refs.
""",
              ok: 'Update ✓',
              submitterParameter: 'UPDATE_APPROVED_BY'
            )
          }
          echo "Approved by: ${env.UPDATE_APPROVED_BY ?: 'unknown'}"
          env.DO_MODULE_UPDATE = 'true'
        }
      }
    }

    // ── 2c. Update module refs + commit back ──────────────────────────────
    stage('Update module refs') {
      when {
        expression { env.DO_MODULE_UPDATE == 'true' }
      }
      steps {
        script {
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          echo " Patching terragrunt.hcl files and pushing"
          echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
          // Patch files and commit (script does not push)
          sh """#!/bin/bash
            bash scripts/update_module_refs.sh '${env.UPDATES_FILE}'
          """
          // Push — Jenkins masks GIT_TOKEN in logs automatically
          withCredentials([usernamePassword(
            credentialsId: params.GIT_CREDENTIALS_ID,
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
          )]) {
            sh """#!/bin/bash
              set -euo pipefail
              BRANCH=\$(git rev-parse --abbrev-ref HEAD)
              git push "https://\${GIT_USER}:\${GIT_TOKEN}@github.com/beravelli/autotfrefresh.git" "HEAD:\${BRANCH}"
              echo "✓ Pushed module ref updates to \${BRANCH}"
            """
          }
          currentBuild.description = "✓ Module refs bumped to latest"
        }
      }
    }

    // ── 3. Discover stacks ─────────────────────────────────────────────────
    stage('Discover stacks') {
      steps {
        script {
          sh "mkdir -p '${env.PLAN_DIR}'"  // no-op if already created by check stage

          def raw = sh(
            script: """
              bash scripts/discover_stacks.sh \
                '${params.ENV_FILTER?.trim()    ?: ''}' \
                '${params.REGION_FILTER?.trim() ?: ''}' \
                '${params.MODULE_FILTER?.trim() ?: ''}' \
                '${params.STACK_FILTER?.trim()  ?: ''}'
            """,
            returnStdout: true
          ).trim()

          def stacks = raw ? raw.split('\n').findAll { it.trim() && !it.startsWith('No stacks') } : []

          if (!stacks) {
            echo "No stacks matched the given filters — nothing to do."
            currentBuild.result = 'SUCCESS'
            return
          }

          env.STACKS_JSON = groovy.json.JsonOutput.toJson(stacks)
          echo "Discovered ${stacks.size()} stack(s):"
          stacks.each { echo "  • ${it}" }
        }
      }
    }

    // ── 4a. Validate ───────────────────────────────────────────────────────
    stage('Validate stacks') {
      when {
        allOf {
          expression { params.ACTION == 'validate' }
          expression { env.STACKS_JSON && env.STACKS_JSON != '[]' }
        }
      }
      steps {
        script {
          def stacks = readJSON(text: env.STACKS_JSON)
          def failed = []
          stacks.each { stackPath ->
            def safe    = stackPath.replace('/', '__')
            def logFile = "${env.PLAN_DIR}/${safe}.log"
            echo "Validating: ${stackPath}"
            def rc = sh(
              script: """#!/bin/bash
                bash scripts/stack_action.sh \
                  '${stackPath}' validate \
                  2>&1 | tee '${logFile}'
                exit \${PIPESTATUS[0]}
              """,
              returnStatus: true
            )
            if (rc != 0) {
              echo "✗ Validation FAILED for ${stackPath}"
              failed << stackPath
            }
          }
          if (failed) {
            unstable("Validation failed for: ${failed.join(', ')}")
          } else {
            echo "✓ All ${stacks.size()} stack(s) validated successfully."
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'plans/**/*.log', allowEmptyArchive: true }
      }
    }

    // ── 4b/c. Plan (for plan or apply actions) ────────────────────────────
    stage('Plan stacks') {
      when {
        allOf {
          expression { params.ACTION in ['plan', 'apply'] }
          expression { env.STACKS_JSON && env.STACKS_JSON != '[]' }
        }
      }
      steps {
        script {
          def stacks = readJSON(text: env.STACKS_JSON)
          def failed = []
          withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-credentials'
          ]]) {
            stacks.each { stackPath ->
              def safe     = stackPath.replace('/', '__')
              def logFile  = "${env.PLAN_DIR}/${safe}.plan.log"
              def planFile = "${env.PLAN_DIR}/${safe}.tfplan"
              echo "Planning: ${stackPath}"
              def rc = sh(
                script: """#!/bin/bash
                  bash scripts/stack_action.sh \
                    '${stackPath}' plan '${planFile}' \
                    2>&1 | tee '${logFile}'
                  exit \${PIPESTATUS[0]}
                """,
                returnStatus: true
              )
              // 0 = no changes, 2 = changes present — both valid plan outcomes
              if (rc != 0 && rc != 2) {
                echo "✗ Plan FAILED for ${stackPath} (exit ${rc})"
                failed << stackPath
              }
            }
          }
          if (failed) {
            unstable("Plan failed for: ${failed.join(', ')}")
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'plans/**/*.plan.log', allowEmptyArchive: true }
      }
    }

    // ── 5. Approval gate ──────────────────────────────────────────────────
    stage('Approval') {
      when {
        allOf {
          expression { params.ACTION == 'apply' }
          not { expression { params.AUTO_APPROVE } }
          expression { env.STACKS_JSON && env.STACKS_JSON != '[]' }
        }
      }
      steps {
        script {
          def stacks    = readJSON(text: env.STACKS_JSON)
          def stackList = stacks.collect { "  • ${it}" }.join('\n')
          def driftNote = env.DRIFT_WARN ? "\n\n${env.DRIFT_WARN}" : ''

          timeout(time: 24, unit: 'HOURS') {
            input message: """\
Action: *APPLY*${driftNote}

Stacks to apply:
${stackList}

Review plan logs in the Artifacts tab above, then approve to apply.
""",
              ok: 'Apply ✓',
              submitterParameter: 'APPROVED_BY'
          }
          echo "Approved by: ${env.APPROVED_BY ?: 'unknown'}"
        }
      }
    }

    // ── 6. Apply ──────────────────────────────────────────────────────────
    stage('Apply stacks') {
      when {
        allOf {
          expression { params.ACTION == 'apply' }
          expression { env.STACKS_JSON && env.STACKS_JSON != '[]' }
        }
      }
      steps {
        script {
          def stacks = readJSON(text: env.STACKS_JSON)
          withCredentials([[
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-credentials'
          ]]) {
            stacks.each { stackPath ->
              def safe     = stackPath.replace('/', '__')
              def planFile = "${env.PLAN_DIR}/${safe}.tfplan"
              def logFile  = "${env.PLAN_DIR}/${safe}.apply.log"
              echo "Applying: ${stackPath}"
              sh """
                bash scripts/stack_action.sh \
                  '${stackPath}' apply '${planFile}' \
                  2>&1 | tee '${logFile}'
              """
            }
          }
        }
      }
      post {
        always { archiveArtifacts artifacts: 'plans/**/*.apply.log', allowEmptyArchive: true }
      }
    }

  } // end stages

  post {
    success {
      script {
        def stacks    = env.STACKS_JSON ? readJSON(text: env.STACKS_JSON) : []
        def driftSufx = env.DRIFT_WARN  ? ' (drift detected)' : ''
        def desc      = "✓ ${params.ACTION.toUpperCase()} — ${stacks.size()} stack(s)${driftSufx}"
        echo desc
        currentBuild.description = currentBuild.description ?: desc
      }
    }
    failure { echo "✗ Live-infra pipeline failed — check stage logs and plan artifacts." }
    aborted { echo "✗ Live-infra pipeline aborted." }
  }
}
